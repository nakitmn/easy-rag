# Шаблон конфигурации RAG-тула. Скопируй в .env (корень репо RAG) и заполни.
# Все переменные обязательны, кроме помеченных. Пустая строка = ошибка (кроме RAG_MAX_FILES).
# Переменные процесса имеют приоритет над .env; относительные пути — от корня репо RAG.

# LLM: домен enrichment (summary/keywords по чанкам кода)
RAG_ENRICHMENT_BASE_URL=https://api.z.ai/api/coding/paas/v4
RAG_ENRICHMENT_MODEL=glm-5.3-flash
RAG_ENRICHMENT_API_KEY=your-enrichment-api-key
RAG_ENRICHMENT_TEMPERATURE=0.1
RAG_ENRICHMENT_CONTEXT_WINDOW=32768
RAG_ENRICHMENT_PREFLIGHT_TIMEOUT=10.0

# LLM: домен query (синтез ответов)
RAG_QUERY_BASE_URL=https://api.z.ai/api/coding/paas/v4
RAG_QUERY_MODEL=glm-5.3-flash
RAG_QUERY_API_KEY=your-query-api-key
RAG_QUERY_TEMPERATURE=0.1
RAG_QUERY_CONTEXT_WINDOW=128000

# Пути (относительные — от корня репо RAG)
# RAG_CODE_PATH — папка с C#-исходниками индексируемого проекта; относительный путь — от корня репо RAG
RAG_CODE_PATH=path/to/your/csharp/sources
RAG_OUTPUT_PATH=ast/data/ast_chunks.jsonl
RAG_INDEX_DIR=ast/data/vector_index

# Чанкинг / extractors
RAG_NUM_WORKERS=4
# может быть пустой = без лимита
RAG_MAX_FILES=
RAG_CHUNK_MAX_CHARS=400000
RAG_NUM_KEYWORDS=5
# файлов на батч ингеста в build_index (персист индекса после каждого батча);
# НЕ путать с RAG_EMBED_BATCH_SIZE (батч эмбеддинга)
RAG_BATCH_SIZE=50

# Embedding (RAG_EMBED_MODEL входит в rag_profile индекса — смена = полная переиндексация)
RAG_EMBED_MODEL=BAAI/bge-m3
# auto = авторедетект mps/cpu, либо явно: mps / cpu / cuda
RAG_EMBED_DEVICE=auto
RAG_EMBED_MAX_LENGTH=8192
RAG_EMBED_BATCH_SIZE=16

# Retrieval / запросы
RAG_TOP_K=20
RAG_SOURCE_MAX_CHARS=6000
